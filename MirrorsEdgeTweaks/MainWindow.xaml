                                        VerticalAlignment="Center"
                                        Margin="0,0,5,0"/>
                                <Button Grid.Column="3" Style="{StaticResource MaterialDesignIconButton}"
                                        Command="{Binding Graphics.ShowInfoCommand}" CommandParameter="LodBias">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>

                            </StackPanel>

                            </Expander>

                            <Separator Margin="0,20" Style="{StaticResource MaterialDesignDarkSeparator}"/>

                            <Expander Style="{StaticResource SectionExpander}">
                                <Expander.Header>
                                    <TextBlock Text="Shaders" Style="{StaticResource SectionExpanderHeaderText}" />
                                </Expander.Header>

                            <controls:SettingRow Margin="0,15,0,0" Label="Tone Mapper:" InfoCommand="{Binding Graphics.ShowInfoCommand}" InfoParameter="ToneMapper">
                                <ComboBox Style="{StaticResource MaterialDesignComboBox}" SelectedIndex="{Binding Graphics.ToneMapperIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Original"/>
                                    <ComboBoxItem Content="Faithful Luma"/>
                                </ComboBox>
                            </controls:SettingRow>

                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid IsHitTestVisible="False" Margin="0,0,15,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5*"/>
                            <RowDefinition Height="90*"/>
                            <RowDefinition Height="5*"/>
                        </Grid.RowDefinitions>
                        <Rectangle Grid.Row="0"
                                   Style="{StaticResource FadeOverlayRectStyle}"
                                   Tag="{Binding ElementName=GraphicsTweaksScrollViewer, Path=(behaviors:SmoothScrollBehavior.ShowTopFade)}">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="White" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Grid.Row="2"
                                   Style="{StaticResource FadeOverlayRectStyle}"
                                   Tag="{Binding ElementName=GraphicsTweaksScrollViewer, Path=(behaviors:SmoothScrollBehavior.ShowBottomFade)}">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="White" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Tune" Margin="0,0,6,0"/>
                        <TextBlock Text="Other Tweaks" FontWeight="Bold"/>
                    </StackPanel>
                </TabItem.Header>
                <Border Background="White" Padding="20">
                    <Grid>
                    <ScrollViewer x:Name="OtherTweaksScrollViewer"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  behaviors:SmoothScrollBehavior.SmoothScroll="True"
                                  behaviors:SmoothScrollBehavior.FadeEdges="True"
                                  Focusable="False">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource MaterialDesignScrollViewer}">
                                <Style.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}" />
                                </Style.Resources>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel Margin="0,0,15,0" Focusable="False" KeyboardNavigation.TabNavigation="None">
                            <Expander Style="{StaticResource SectionExpander}">
                                <Expander.Header>
                                    <TextBlock Text="Input Settings" Style="{StaticResource SectionExpanderHeaderText}" />
                                </Expander.Header>

                            <StackPanel>
                            
                            <controls:SettingRow Margin="0,15,0,0" Label="Mouse Smoothing:" Foreground="Black" InfoCommand="{Binding Input.ShowMouseSmoothingInfoCommand}">
                                <ComboBox Style="{StaticResource MaterialDesignComboBox}" Foreground="Black" SelectedIndex="{Binding Input.MouseSmoothingIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Enabled" Foreground="Black"/>
                                    <ComboBoxItem Content="Disabled" Foreground="Black"/>
                                </ComboBox>
                            </controls:SettingRow>
                            
                            <controls:SettingRow Margin="0,15,0,0" Label="Uniform Sensitivity:" Foreground="Black" InfoCommand="{Binding Input.ShowUniformSensitivityInfoCommand}">
                                <ComboBox Style="{StaticResource MaterialDesignComboBox}" Foreground="Black" SelectedIndex="{Binding Input.UniformSensitivityIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Enabled" Foreground="Black"/>
                                    <ComboBoxItem Content="Disabled" Foreground="Black"/>
                                </ComboBox>
                            </controls:SettingRow>
                            
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="cm/360° Converter:" VerticalAlignment="Center"
                                           FontWeight="Bold" Margin="0,0,20,0" Foreground="Black"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox                                             Text="{Binding Input.Dpi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="64" 
                                             VerticalAlignment="Center"
                                             Style="{StaticResource MaterialDesignTextBox}"
                                             materialDesign:HintAssist.Hint="DPI"
                                             Foreground="Black"
                                             Margin="0,0,10,0"/>
                                    <TextBox                                             Text="{Binding Input.Cm360, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="64" 
                                             VerticalAlignment="Center"
                                             Style="{StaticResource MaterialDesignTextBox}"
                                             materialDesign:HintAssist.Hint="360° (cm)"
                                             Foreground="Black"
                                             Margin="0,0,10,0"/>
                                    <Button Content="Apply" 
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0"
                                            Command="{Binding Input.ApplyCm360Command}"/>
                                    <Button Content="Reset" 
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,0,0"
                                            Command="{Binding Input.ResetCm360Command}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                        Margin="5,0,0,0"
                                        Command="{Binding Input.ShowCm360InfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>
                            
                            <controls:SettingRow Margin="0,15,0,0" Label="Gamepad Buttons:" Foreground="Black" InfoCommand="{Binding Input.ShowGamepadButtonsInfoCommand}">
                                <ComboBox Style="{StaticResource MaterialDesignComboBox}" Foreground="Black" SelectedIndex="{Binding Input.GamepadButtonsIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Xbox" Foreground="Black"/>
                                    <ComboBoxItem Content="PS3" Foreground="Black"/>
                                </ComboBox>
                            </controls:SettingRow>

                            </StackPanel>

                            </Expander>

                            <Separator Margin="0,20" Style="{StaticResource MaterialDesignDarkSeparator}"/>
                            
                            <Expander Style="{StaticResource SectionExpander}">
                                <Expander.Header>
                                    <TextBlock Text="Custom Keybinds" Style="{StaticResource SectionExpanderHeaderText}" />
                                </Expander.Header>
                            
                            <ItemsControl ItemsSource="{Binding Keybinds.CustomKeybinds}" ItemTemplate="{StaticResource KeybindRowTemplate}"/>

                            </Expander>
                            
                            <Separator Margin="0,20" Style="{StaticResource MaterialDesignDarkSeparator}"/>
                            
                            <Expander Style="{StaticResource SectionExpander}">
                                <Expander.Header>
                                    <TextBlock Text="Cheat/Trainer Keybinds" Style="{StaticResource SectionExpanderHeaderText}" />
                                </Expander.Header>
                            
                            <ItemsControl ItemsSource="{Binding Keybinds.CheatTrainerKeybinds}" ItemTemplate="{StaticResource KeybindRowTemplate}"/>

                            </Expander>

                            <Separator Margin="0,20" Style="{StaticResource MaterialDesignDarkSeparator}"/>

                            <Expander Style="{StaticResource SectionExpander}">
                                <Expander.Header>
                                    <TextBlock Text="Macro Keybinds (Softimer)" Style="{StaticResource SectionExpanderHeaderText}" />
                                </Expander.Header>

                            <ItemsControl ItemsSource="{Binding Keybinds.MacroKeybinds}" ItemTemplate="{StaticResource KeybindRowTemplate}"/>

                            </Expander>
                            
                            <Separator Margin="0,20" Style="{StaticResource MaterialDesignDarkSeparator}"/>
                            
                            <Expander Style="{StaticResource SectionExpander}">
                                <Expander.Header>
                                    <TextBlock Text="Initialisation Settings" Style="{StaticResource SectionExpanderHeaderText}" />
                                </Expander.Header>

                            <StackPanel>
                            
                            <controls:SettingRow Margin="0,15,0,0" Label="Intro Video:" Foreground="Black" InfoCommand="{Binding Init.ShowIntroVideoInfoCommand}">
                                <ComboBox Style="{StaticResource MaterialDesignComboBox}" Foreground="Black" SelectedIndex="{Binding Init.IntroVideoIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Enabled" Foreground="Black"/>
                                    <ComboBoxItem Content="Disabled" Foreground="Black"/>
                                </ComboBox>
                            </controls:SettingRow>
                            
                            <controls:SettingRow Margin="0,15,0,0" Label="Main Menu Delay:" Foreground="Black" InfoCommand="{Binding Init.ShowMainMenuDelayInfoCommand}">
                                <ComboBox Style="{StaticResource MaterialDesignComboBox}" Foreground="Black" SelectedIndex="{Binding Init.MainMenuDelayIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Enabled" Foreground="Black"/>
                                    <ComboBoxItem Content="Disabled" Foreground="Black"/>
                                </ComboBox>
                            </controls:SettingRow>
                            
                            <controls:SettingRow Margin="0,15,0,0" Label="Time Trial Countdown:" Foreground="Black" InfoCommand="{Binding Init.ShowTimeTrialCountdownInfoCommand}">
                                <ComboBox Style="{StaticResource MaterialDesignComboBox}" Foreground="Black" SelectedIndex="{Binding Init.TimeTrialCountdownIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="4 seconds (default)" Foreground="Black"/>
                                    <ComboBoxItem Content="3 seconds ('Ready' message starts sooner)" Foreground="Black"/>
                                    <ComboBoxItem Content="2 seconds (starts on 'Set' message)" Foreground="Black"/>
                                    <ComboBoxItem Content="1 second (starts on 'Go' message)" Foreground="Black"/>
                                </ComboBox>
                            </controls:SettingRow>

                            <controls:SettingRow Margin="0,15,0,0" Label="Skip Online Check:" Foreground="Black" InfoCommand="{Binding Init.ShowSkipOnlineCheckInfoCommand}">
                                <ComboBox Style="{StaticResource MaterialDesignComboBox}" Foreground="Black" SelectedIndex="{Binding Init.SkipOnlineIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Disabled" Foreground="Black"/>
                                    <ComboBoxItem Content="Enabled" Foreground="Black"/>
                                </ComboBox>
                            </controls:SettingRow>

                            </StackPanel>

                            </Expander>

                            <Separator Margin="0,20" Style="{StaticResource MaterialDesignDarkSeparator}"/>

                            <Expander Style="{StaticResource SectionExpander}">
                                <Expander.Header>
                                    <TextBlock Text="Community Mods" Style="{StaticResource SectionExpanderHeaderText}" />
                                </Expander.Header>

                            <controls:SettingRow Margin="0,15,0,0" Label="Cinematic Faith Model:" Foreground="Black" InfoCommand="{Binding CommunityMods.ShowCinematicFaithInfoCommand}">
                                <ComboBox Style="{StaticResource MaterialDesignComboBox}" Foreground="Black" SelectedIndex="{Binding CommunityMods.CinematicFaithIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Disabled" Foreground="Black"/>
                                    <ComboBoxItem Content="Enabled" Foreground="Black"/>
                                </ComboBox>
                            </controls:SettingRow>

                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid IsHitTestVisible="False" Margin="0,0,15,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5*"/>
                            <RowDefinition Height="90*"/>
                            <RowDefinition Height="5*"/>
                        </Grid.RowDefinitions>
                        <Rectangle Grid.Row="0"
                                   Style="{StaticResource FadeOverlayRectStyle}"
                                   Tag="{Binding ElementName=OtherTweaksScrollViewer, Path=(behaviors:SmoothScrollBehavior.ShowTopFade)}">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="White" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Grid.Row="2"
                                   Style="{StaticResource FadeOverlayRectStyle}"
                                   Tag="{Binding ElementName=OtherTweaksScrollViewer, Path=(behaviors:SmoothScrollBehavior.ShowBottomFade)}">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="White" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
        </Border>

        <StatusBar Grid.Row="4" BorderThickness="0">
            <StatusBarItem VerticalAlignment="Center">
                <TextBlock Text="{Binding GameStatus.Status}"
                           VerticalAlignment="Center"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right" VerticalAlignment="Center">
                <ProgressBar Value="{Binding DownloadProgress.DownloadProgressValue}"
                             IsIndeterminate="{Binding DownloadProgress.IsDownloadProgressIndeterminate}"
                             Width="150" Height="12"
                             Visibility="{Binding DownloadProgress.IsDownloadProgressVisible, Converter={StaticResource BoolToVis}}"
                             VerticalAlignment="Center"/>
            </StatusBarItem>
        </StatusBar>
        </Grid>

        <Border Panel.ZIndex="1000"
                Background="#50000000"
                Visibility="{Binding GameStatus.IsGameRunning, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                </StackPanel.Effect>
                <materialDesign:PackIcon Kind="LockOutline" Width="48" Height="48"
                                         HorizontalAlignment="Center" Foreground="White"/>
                <TextBlock Text="Tweaks locked" FontSize="20" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="Close Mirror's Edge to continue." FontWeight="Bold"
                           Foreground="White" Opacity="0.85" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
    </materialDesign:DialogHost>
</Window>
