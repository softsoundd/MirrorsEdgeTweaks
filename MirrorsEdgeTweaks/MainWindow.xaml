<Window x:Class="MirrorsEdgeTweaks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MirrorsEdgeTweaks"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:behaviors="clr-namespace:MirrorsEdgeTweaks.Behaviors"
        xmlns:controls="clr-namespace:MirrorsEdgeTweaks.Controls"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Title="Mirror's Edge Tweaks"
        Height="800" Width="650"
        Loaded="Window_Loaded"
        Icon="Icon.ico"
        ResizeMode="CanMinimize"
        IsEnabled="{Binding GameStatus.IsUiEnabled}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Shared row template for all keybind entries (Custom / Cheat-Trainer / Macro sections).
             Replaces the 19 previously copy-pasted per-keybind grids. -->
        <DataTemplate x:Key="KeybindRowTemplate">
            <Grid Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                           FontWeight="Bold" Margin="0,0,20,0" Foreground="Black"/>
                <TextBox Grid.Column="1" Text="{Binding DisplayKey, Mode=OneWay}"
                         VerticalAlignment="Center"
                         Style="{StaticResource MaterialDesignTextBox}"
                         Foreground="Black"
                         materialDesign:HintAssist.Hint="Click to set keybind"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="False"
                         Focusable="False"
                         Cursor="Hand">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                            <b:InvokeCommandAction Command="{Binding CaptureCommand}"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </TextBox>
                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                        Margin="5,0,0,0"
                        Command="{Binding ShowInfoCommand}">
                    <materialDesign:PackIcon Kind="Information" />
                </Button>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="RootDialog">
    <Grid Margin="10">
        <Grid x:Name="ContentRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding GameStatus.IsGameRunning}" Value="True">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <BlurEffect Radius="12" KernelType="Gaussian"/>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button Command="{Binding SelectGameDirectoryCommand}"
                    Padding="10,5"
                    DockPanel.Dock="Right"
                    Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FolderSearchOutline"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="Select Game Directory"/>
                </StackPanel>
            </Button>
            <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    Margin="0,0,10,0"
                    CornerRadius="4">
                <TextBlock Text="{Binding GameStatus.GameDirectoryPath}"
                           VerticalAlignment="Center"
                           Padding="5"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="TagOutline"
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0"
                                         Opacity="0.7"/>
                <TextBlock Text="{Binding GameStatus.GameVersion}"
                           Opacity="0.7"/>
            </StackPanel>
            <Separator Style="{StaticResource MaterialDesignLightSeparator}" Margin="16,0"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="FileDocumentOutline"
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0"
                                         Opacity="0.7"/>
                <TextBlock Text="{Binding GameStatus.ConfigStatus}"
                           Foreground="{Binding GameStatus.ConfigStatusForeground}"
                           Opacity="0.7"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5,10,0,30">
            <Button Command="{Binding LaunchGameCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="0,0,10,0"
                    Height="28"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Play" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Launch Game" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding LaunchGameWithArgsCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Height="28"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Play" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Launch Game w/ Args" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="LightGray" BorderThickness="0,2,0,0" Margin="0,0,0,0">
            <TabControl x:Name="MainTabControl" Margin="0,0,0,10"
                    BorderThickness="0"
                    Padding="0"
                    IsEnabled="{Binding GameStatus.IsMainTabEnabled}"
                    KeyboardNavigation.TabNavigation="None">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                    <Setter Property="Background" Value="{DynamicResource PrimaryHueDarkBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryHueDarkForegroundBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidForegroundBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="GamepadVariant"
                                                 Margin="0,0,6,0"/>
                        <TextBlock Text="Game Tweaks" FontWeight="Bold"/>
                    </StackPanel>
                </TabItem.Header>

                <Border Background="White" Padding="20">
                    <Grid>
                    <ScrollViewer x:Name="GameTweaksScrollViewer"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  behaviors:SmoothScrollBehavior.SmoothScroll="True"
                                  behaviors:SmoothScrollBehavior.FadeEdges="True"
                                  Focusable="False">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource MaterialDesignScrollViewer}">
                                <Style.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}" />
                                </Style.Resources>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel TextElement.Foreground="Black" Margin="0,0,15,0" 
                                    IsEnabled="{Binding GameStatus.IsGameTweaksEnabled}"
                                    Focusable="False" KeyboardNavigation.TabNavigation="None">

                            <Expander Style="{StaticResource SectionExpander}">
                                <Expander.Header>
                                    <TextBlock Text="Mods" Style="{StaticResource SectionExpanderHeaderText}" />
                                </Expander.Header>

                            <StackPanel>

                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="TdGame Version:" VerticalAlignment="Center"
                                           FontWeight="Bold" Margin="0,0,36,0"/>
                                <ComboBox Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource MaterialDesignComboBox}"
                                          SelectedIndex="{Binding TdGameVersion.SelectedVersionIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Original"/>
                                    <ComboBoxItem Content="TdGame Fix (by Keku)"/>
                                    <ComboBoxItem Content="Time Trials Timer Fix (by Nulaft)"/>
                                    <ComboBoxItem Content="TdGame Fix + Time Trials Timer Fix"/>
                                </ComboBox>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                        Margin="5,0,0,0"
                                        Command="{Binding Mods.ShowTdGameVersionInfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>

                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Developer Console:" VerticalAlignment="Center"
                                           FontWeight="Bold" MinWidth="140" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Install"
                                            Command="{Binding Mods.InstallConsoleCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,10,0"/>
                                    <Button Content="Uninstall"
                                            Command="{Binding Mods.UninstallConsoleCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                    <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Console.ConsoleStatus}" 
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding Console.ConsoleStatusForeground}"/>
                                    </Border>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                        Margin="5,0,0,0"
                                        Command="{Binding Mods.ShowConsoleInfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>

                            <Border Margin="0,15,0,0"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,10,10,8"
                                    Background="#0D000000">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="179"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Tweaks Scripts:" VerticalAlignment="Center"
                                                   FontWeight="Bold" MinWidth="129" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Install"
                                                    Command="{Binding Mods.InstallTweaksScriptsCommand}"
                                                    Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,10,0"/>
                                            <Button Content="Uninstall"
                                                    Command="{Binding Mods.UninstallTweaksScriptsCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                    BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TweaksScripts.TweaksScriptsStatus}" 
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{Binding TweaksScripts.TweaksScriptsStatusForeground}"/>
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                                Margin="5,0,0,0"
                                                Command="{Binding Mods.ShowTweaksScriptsInfoCommand}">
                                            <materialDesign:PackIcon Kind="Information" />
                                        </Button>
                                    </Grid>

                                    <StackPanel Margin="0,10,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="179"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Tweaks Scripts UI:" VerticalAlignment="Center"
                                                       FontWeight="Bold" MinWidth="129" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="Install"
                                                        Command="{Binding Mods.InstallTweaksScriptsUICommand}"
                                                        IsEnabled="{Binding TweaksScripts.IsTweaksScriptsUIInstallEnabled}"
                                                        ToolTip="{Binding TweaksScripts.TweaksScriptsUIInstallTooltip}"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,10,0"/>
                                                <Button Content="Uninstall"
                                                        Command="{Binding Mods.UninstallTweaksScriptsUICommand}"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                                <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                        BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TweaksScripts.TweaksScriptsUIStatus}" 
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{Binding TweaksScripts.TweaksScriptsUIStatusForeground}"/>
                                                </Border>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                                    Margin="5,0,0,0"
                                                    Command="{Binding Mods.ShowTweaksScriptsUIInfoCommand}">
                                                <materialDesign:PackIcon Kind="Information" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="Install 'Tweaks Scripts' first to enable Tweaks Scripts UI installation."
                                                   Margin="0,6,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   Visibility="{Binding TweaksScripts.IsTweaksScriptsUIDependencyTextVisible, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            </StackPanel>

                            </Expander>

                            <Separator Margin="0,20" Style="{StaticResource MaterialDesignDarkSeparator}"/>

                            <Expander Style="{StaticResource SectionExpander}">
                                <Expander.Header>
                                    <TextBlock Text="Patches" Style="{StaticResource SectionExpanderHeaderText}" />
                                </Expander.Header>

                            <StackPanel>

                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Unlocked Configs:" VerticalAlignment="Center"
                                           FontWeight="Bold" MinWidth="140" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Patch"
                                            Command="{Binding Patches.PatchConfigsCommand}"
                                            IsEnabled="{Binding UnlockedConfigs.IsPatchConfigsEnabled}"
                                            Style="{StaticResource MaterialDesignRaisedButton}" Width="70" Margin="0,0,10,0"/>
                                    <Button Content="Unpatch"
                                            Command="{Binding Patches.UnpatchConfigsCommand}"
                                            IsEnabled="{Binding UnlockedConfigs.IsUnpatchConfigsEnabled}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Width="87"/>
                                    <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UnlockedConfigs.UnlockedConfigsStatus}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding UnlockedConfigs.UnlockedConfigsStatusForeground}"/>
                                    </Border>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                        Margin="5,0,0,0"
                                        Command="{Binding Patches.ShowUnlockedConfigsInfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>

                            <StackPanel Margin="0,15,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Launch Arguments:" VerticalAlignment="Center"
                                               FontWeight="Bold" MinWidth="140" Margin="0,0,10,0"/>
                                    <TextBox Grid.Row="1"
                                             Grid.Column="0"
                                             Grid.ColumnSpan="3"
                                             Margin="0,8,0,0"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource MaterialDesignTextBox}"
                                             Text="{Binding LaunchArguments.LaunchArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Enter launch arguments"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Patch"
                                                Command="{Binding LaunchArguments.ApplyLaunchArgumentsCommand}"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Width="70"
                                                Margin="0,0,10,0"/>
                                        <Button Content="Unpatch"
                                                Command="{Binding LaunchArguments.ResetLaunchArgumentsCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Width="87"/>
                                    </StackPanel>
                                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                            Margin="5,0,0,0"
                                            Command="{Binding LaunchArguments.ShowLaunchArgumentsInfoCommand}">
                                        <materialDesign:PackIcon Kind="Information" />
                                    </Button>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="1"
                                            Grid.ColumnSpan="3"
                                            Background="{DynamicResource MaterialDesignCardBackground}"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,2"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding LaunchArguments.PatchStatus}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding LaunchArguments.PatchStatusForeground}"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <Expander Style="{StaticResource SubSectionExpander}">
                                <Expander.Header>
                                    <TextBlock Text="Other Patches" Style="{StaticResource SubSectionExpanderHeaderText}" />
                                </Expander.Header>
                                <StackPanel Margin="0,10,0,0">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Enable Logging:" VerticalAlignment="Center"
                                                   FontWeight="Bold" MinWidth="140" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Patch"
                                                    Command="{Binding Patches.PatchLoggingCommand}"
                                                    Style="{StaticResource MaterialDesignRaisedButton}" Width="70" Margin="0,0,10,0"/>
                                            <Button Content="Unpatch"
                                                    Command="{Binding Patches.UnpatchLoggingCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" Width="87"/>
                                            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                    BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Patches.LoggingPatchStatus}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Patches.LoggingPatchStatusForeground}"/>
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                                Margin="5,0,0,0"
                                                Command="{Binding Patches.ShowLoggingInfoCommand}">
                                            <materialDesign:PackIcon Kind="Information" />
                                        </Button>
                                    </Grid>

                                    <Grid Margin="0,15,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Multi-instance:" VerticalAlignment="Center"
                                                   FontWeight="Bold" MinWidth="140" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Patch"
                                                    Command="{Binding Patches.PatchMultiInstanceCommand}"
                                                    Style="{StaticResource MaterialDesignRaisedButton}" Width="70" Margin="0,0,10,0"/>
                                            <Button Content="Unpatch"
                                                    Command="{Binding Patches.UnpatchMultiInstanceCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" Width="87"/>
                                            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                    BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Patches.MultiInstancePatchStatus}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Patches.MultiInstancePatchStatusForeground}"/>
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                                Margin="5,0,0,0"
                                                Command="{Binding Patches.ShowMultiInstanceInfoCommand}">
                                            <materialDesign:PackIcon Kind="Information" />
                                        </Button>
                                    </Grid>

                                    <Grid Margin="0,15,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Ambiguous Bypass:" VerticalAlignment="Center"
                                                   FontWeight="Bold" MinWidth="140" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Patch"
                                                    Command="{Binding Patches.PatchAmbiguousBypassCommand}"
                                                    Style="{StaticResource MaterialDesignRaisedButton}" Width="70" Margin="0,0,10,0"/>
                                            <Button Content="Unpatch"
                                                    Command="{Binding Patches.UnpatchAmbiguousBypassCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" Width="87"/>
                                            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                    BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Patches.AmbiguousBypassPatchStatus}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Patches.AmbiguousBypassPatchStatusForeground}"/>
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                                Margin="5,0,0,0"
                                                Command="{Binding Patches.ShowAmbiguousBypassInfoCommand}">
                                            <materialDesign:PackIcon Kind="Information" />
                                        </Button>
                                    </Grid>

                                </StackPanel>
                            </Expander>

                            </StackPanel>

                            </Expander>
                            
                            <Separator Margin="0,20" Style="{StaticResource MaterialDesignDarkSeparator}"/>
                            
                            <Expander Style="{StaticResource SectionExpander}">
                                <Expander.Header>
                                    <TextBlock Text="Audio Settings" Style="{StaticResource SectionExpanderHeaderText}" />
                                </Expander.Header>

                            <StackPanel>
                            
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Game Language:" VerticalAlignment="Center"
                                           FontWeight="Bold" Margin="0,0,36,0" Foreground="Black"/>
                                <ComboBox Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource MaterialDesignComboBox}"
                                          Foreground="Black"
                                          SelectedIndex="{Binding Language.SelectedLanguageIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Čeština (CZE)" Foreground="Black"/>
                                    <ComboBoxItem Content="Deutsch (DEU)" Foreground="Black"/>
                                    <ComboBoxItem Content="English (INT)" Foreground="Black"/>
                                    <ComboBoxItem Content="Español (ESN)" Foreground="Black"/>
                                    <ComboBoxItem Content="Français (FRA)" Foreground="Black"/>
                                    <ComboBoxItem Content="Italiano (ITA)" Foreground="Black"/>
                                    <ComboBoxItem Content="Magyar (HUN)" Foreground="Black"/>
                                    <ComboBoxItem Content="Polski (POL)" Foreground="Black"/>
                                    <ComboBoxItem Content="Português (POR)" Foreground="Black"/>
                                    <ComboBoxItem Content="Русский (RUS)" Foreground="Black"/>
                                    <ComboBoxItem Content="한국어 (KOR)" Foreground="Black"/>
                                    <ComboBoxItem Content="台灣繁體中文 (CHT)" Foreground="Black"/>
                                    <ComboBoxItem Content="日本語 (JPN)" Foreground="Black"/>
                                    <ComboBoxItem Content="简体中文 (CHS)" Foreground="Black"/>
                                </ComboBox>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                        Margin="5,0,0,0"
                                        Command="{Binding Language.ShowGameLanguageInfoCommand}">
