<Window x:Class="MirrorsEdgeTweaks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MirrorsEdgeTweaks"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:behaviors="clr-namespace:MirrorsEdgeTweaks.Behaviors"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Title="Mirror's Edge Tweaks"
        Height="800" Width="650"
        Loaded="Window_Loaded"
        Icon="Icon.ico"
        ResizeMode="CanMinimize"
        IsEnabled="{Binding GameStatus.IsUiEnabled}"
        WindowStartupLocation="CenterScreen">

    <materialDesign:DialogHost Identifier="RootDialog">
    <Grid Margin="10">
        <Grid x:Name="ContentRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding GameStatus.IsGameRunning}" Value="True">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <BlurEffect Radius="12" KernelType="Gaussian"/>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button Command="{Binding SelectGameDirectoryCommand}"
                    Padding="10,5"
                    DockPanel.Dock="Right"
                    Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FolderSearchOutline"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="Select Game Directory"/>
                </StackPanel>
            </Button>
            <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    Margin="0,0,10,0"
                    CornerRadius="4">
                <TextBlock Text="{Binding GameStatus.GameDirectoryPath}"
                           VerticalAlignment="Center"
                           Padding="5"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="TagOutline"
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0"
                                         Opacity="0.7"/>
                <TextBlock Text="{Binding GameStatus.GameVersion}"
                           Opacity="0.7"/>
            </StackPanel>
            <Separator Style="{StaticResource MaterialDesignLightSeparator}" Margin="16,0"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="FileDocumentOutline"
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0"
                                         Opacity="0.7"/>
                <TextBlock Text="{Binding GameStatus.ConfigStatus}"
                           Foreground="{Binding GameStatus.ConfigStatusForeground}"
                           Opacity="0.7"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5,10,0,30">
            <Button Command="{Binding LaunchGameCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="0,0,10,0"
                    Height="28"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Play" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Launch Game" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding LaunchGameWithArgsCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Height="28"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Play" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Launch Game w/ Args" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="LightGray" BorderThickness="0,2,0,0" Margin="0,0,0,0">
            <TabControl Margin="0,0,0,10"
                    BorderThickness="0"
                    Padding="0"
                    IsEnabled="{Binding GameStatus.IsMainTabEnabled}"
                    KeyboardNavigation.TabNavigation="None">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                    <Setter Property="Background" Value="{DynamicResource PrimaryHueDarkBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryHueDarkForegroundBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidForegroundBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="GamepadVariant"
                                                 Margin="0,0,6,0"/>
                        <TextBlock Text="Game Tweaks" FontWeight="Bold"/>
                    </StackPanel>
                </TabItem.Header>

                <Border Background="White" Padding="20">
                    <Grid>
                    <ScrollViewer x:Name="GameTweaksScrollViewer"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  behaviors:SmoothScrollBehavior.SmoothScroll="True"
                                  behaviors:SmoothScrollBehavior.FadeEdges="True"
                                  Focusable="False">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource MaterialDesignScrollViewer}">
                                <Style.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}" />
                                </Style.Resources>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel TextElement.Foreground="Black" Margin="0,0,15,0" 
                                    IsEnabled="{Binding GameStatus.IsGameTweaksEnabled}"
                                    Focusable="False" KeyboardNavigation.TabNavigation="None">

                            <!-- Mods Header -->
                            <Border Background="{DynamicResource PrimaryHueLightBrush}" 
                                    CornerRadius="4" Padding="10,5" Margin="0,0,0,10">
                                <TextBlock Text="Mods" FontWeight="Bold" FontSize="16" 
                                           Foreground="White" VerticalAlignment="Center"/>
                            </Border>

                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="TdGame Version:" VerticalAlignment="Center"
                                           FontWeight="Bold" Margin="0,0,36,0"/>
                                <ComboBox Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource MaterialDesignComboBox}"
                                          SelectedIndex="{Binding TdGameVersion.SelectedVersionIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Original"/>
                                    <ComboBoxItem Content="TdGame Fix (by Keku)"/>
                                    <ComboBoxItem Content="Time Trials Timer Fix (by Nulaft)"/>
                                    <ComboBoxItem Content="TdGame Fix + Time Trials Timer Fix"/>
                                </ComboBox>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Information"
                                        Margin="5,0,0,0"
                                        Command="{Binding Mods.ShowTdGameVersionInfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>

                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Developer Console:" VerticalAlignment="Center"
                                           FontWeight="Bold" MinWidth="140" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Install"
                                            Command="{Binding Mods.InstallConsoleCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,10,0"/>
                                    <Button Content="Uninstall"
                                            Command="{Binding Mods.UninstallConsoleCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                    <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Console.ConsoleStatus}" 
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding Console.ConsoleStatusForeground}"/>
                                    </Border>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Information"
                                        Margin="5,0,0,0"
                                        Command="{Binding Mods.ShowConsoleInfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>

                            <Border Margin="0,15,0,0"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,10,10,8"
                                    Background="#0D000000">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="179"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Tweaks Scripts:" VerticalAlignment="Center"
                                                   FontWeight="Bold" MinWidth="129" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Install"
                                                    Command="{Binding Mods.InstallTweaksScriptsCommand}"
                                                    Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,10,0"/>
                                            <Button Content="Uninstall"
                                                    Command="{Binding Mods.UninstallTweaksScriptsCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                    BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TweaksScripts.TweaksScriptsStatus}" 
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{Binding TweaksScripts.TweaksScriptsStatusForeground}"/>
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Information"
                                                Margin="5,0,0,0"
                                                Command="{Binding Mods.ShowTweaksScriptsInfoCommand}">
                                            <materialDesign:PackIcon Kind="Information" />
                                        </Button>
                                    </Grid>

                                    <StackPanel Margin="0,10,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="179"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Tweaks Scripts UI:" VerticalAlignment="Center"
                                                       FontWeight="Bold" MinWidth="129" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="Install"
                                                        Command="{Binding Mods.InstallTweaksScriptsUICommand}"
                                                        IsEnabled="{Binding TweaksScripts.IsTweaksScriptsUIInstallEnabled}"
                                                        ToolTip="{Binding TweaksScripts.TweaksScriptsUIInstallTooltip}"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,10,0"/>
                                                <Button Content="Uninstall"
                                                        Command="{Binding Mods.UninstallTweaksScriptsUICommand}"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                                <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                        BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TweaksScripts.TweaksScriptsUIStatus}" 
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{Binding TweaksScripts.TweaksScriptsUIStatusForeground}"/>
                                                </Border>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                                    ToolTip="Information"
                                                    Margin="5,0,0,0"
                                                    Command="{Binding Mods.ShowTweaksScriptsUIInfoCommand}">
                                                <materialDesign:PackIcon Kind="Information" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="Install 'Tweaks Scripts' first to enable Tweaks Scripts UI installation."
                                                   Margin="0,6,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   Visibility="{Binding TweaksScripts.IsTweaksScriptsUIDependencyTextVisible, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Separator Margin="0,20" Style="{StaticResource MaterialDesignDarkSeparator}"/>

                            <!-- Patches Header -->
                            <Border Background="{DynamicResource PrimaryHueLightBrush}" 
                                    CornerRadius="4" Padding="10,5" Margin="0,0,0,10">
                                <TextBlock Text="Patches" FontWeight="Bold" FontSize="16" 
                                           Foreground="White" VerticalAlignment="Center"/>
                            </Border>

                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Unlocked Configs:" VerticalAlignment="Center"
                                           FontWeight="Bold" MinWidth="140" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Patch"
                                            Command="{Binding Patches.PatchConfigsCommand}"
                                            IsEnabled="{Binding UnlockedConfigs.IsPatchConfigsEnabled}"
                                            Style="{StaticResource MaterialDesignRaisedButton}" Width="70" Margin="0,0,10,0"/>
                                    <Button Content="Unpatch"
                                            Command="{Binding Patches.UnpatchConfigsCommand}"
                                            IsEnabled="{Binding UnlockedConfigs.IsUnpatchConfigsEnabled}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Width="87"/>
                                    <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UnlockedConfigs.UnlockedConfigsStatus}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding UnlockedConfigs.UnlockedConfigsStatusForeground}"/>
                                    </Border>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Information"
                                        Margin="5,0,0,0"
                                        Command="{Binding Patches.ShowUnlockedConfigsInfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>

                            <StackPanel Margin="0,15,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Launch Arguments:" VerticalAlignment="Center"
                                               FontWeight="Bold" MinWidth="140" Margin="0,0,10,0"/>
                                    <TextBox Grid.Row="1"
                                             Grid.Column="0"
                                             Grid.ColumnSpan="3"
                                             Margin="0,8,0,0"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource MaterialDesignTextBox}"
                                             Text="{Binding LaunchArguments.LaunchArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Enter launch arguments"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Patch"
                                                Command="{Binding LaunchArguments.ApplyLaunchArgumentsCommand}"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Width="70"
                                                Margin="0,0,10,0"/>
                                        <Button Content="Unpatch"
                                                Command="{Binding LaunchArguments.ResetLaunchArgumentsCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Width="87"/>
                                    </StackPanel>
                                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Information"
                                            Margin="5,0,0,0"
                                            Command="{Binding LaunchArguments.ShowLaunchArgumentsInfoCommand}">
                                        <materialDesign:PackIcon Kind="Information" />
                                    </Button>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="1"
                                            Grid.ColumnSpan="3"
                                            Background="{DynamicResource MaterialDesignCardBackground}"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,2"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding LaunchArguments.PatchStatus}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding LaunchArguments.PatchStatusForeground}"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- Other Patches -->
                            <Expander Margin="0,25,0,0"
                                      IsExpanded="False"
                                      HorizontalAlignment="Stretch"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Style="{StaticResource MaterialDesignExpander}"
                                      materialDesign:ExpanderAssist.HorizontalHeaderPadding="0">
                                <Expander.Header>
                                    <TextBlock Text="Other Patches"
                                               FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource MaterialDesignBodyDark}"/>
                                </Expander.Header>
                                <StackPanel Margin="0,10,0,0">

                                    <!-- Enable Logging -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Enable Logging:" VerticalAlignment="Center"
                                                   FontWeight="Bold" MinWidth="140" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Patch"
                                                    Command="{Binding Patches.PatchLoggingCommand}"
                                                    Style="{StaticResource MaterialDesignRaisedButton}" Width="70" Margin="0,0,10,0"/>
                                            <Button Content="Unpatch"
                                                    Command="{Binding Patches.UnpatchLoggingCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" Width="87"/>
                                            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                    BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Patches.LoggingPatchStatus}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Patches.LoggingPatchStatusForeground}"/>
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Information"
                                                Margin="5,0,0,0"
                                                Command="{Binding Patches.ShowLoggingInfoCommand}">
                                            <materialDesign:PackIcon Kind="Information" />
                                        </Button>
                                    </Grid>

                                    <!-- Multi-instance -->
                                    <Grid Margin="0,15,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Multi-instance:" VerticalAlignment="Center"
                                                   FontWeight="Bold" MinWidth="140" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Patch"
                                                    Command="{Binding Patches.PatchMultiInstanceCommand}"
                                                    Style="{StaticResource MaterialDesignRaisedButton}" Width="70" Margin="0,0,10,0"/>
                                            <Button Content="Unpatch"
                                                    Command="{Binding Patches.UnpatchMultiInstanceCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" Width="87"/>
                                            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                    BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Patches.MultiInstancePatchStatus}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Patches.MultiInstancePatchStatusForeground}"/>
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Information"
                                                Margin="5,0,0,0"
                                                Command="{Binding Patches.ShowMultiInstanceInfoCommand}">
                                            <materialDesign:PackIcon Kind="Information" />
                                        </Button>
                                    </Grid>

                                    <!-- Ambiguous Bypass -->
                                    <Grid Margin="0,15,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Ambiguous Bypass:" VerticalAlignment="Center"
                                                   FontWeight="Bold" MinWidth="140" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Patch"
                                                    Command="{Binding Patches.PatchAmbiguousBypassCommand}"
                                                    Style="{StaticResource MaterialDesignRaisedButton}" Width="70" Margin="0,0,10,0"/>
                                            <Button Content="Unpatch"
                                                    Command="{Binding Patches.UnpatchAmbiguousBypassCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" Width="87"/>
                                            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                    BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Patches.AmbiguousBypassPatchStatus}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Patches.AmbiguousBypassPatchStatusForeground}"/>
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Information"
                                                Margin="5,0,0,0"
                                                Command="{Binding Patches.ShowAmbiguousBypassInfoCommand}">
                                            <materialDesign:PackIcon Kind="Information" />
                                        </Button>
                                    </Grid>

                                </StackPanel>
                            </Expander>
                            
                            <Separator Margin="0,20" Style="{StaticResource MaterialDesignDarkSeparator}"/>
                            
                            <!-- Audio Settings Header -->
                            <Border Background="{DynamicResource PrimaryHueLightBrush}" 
                                    CornerRadius="4" Padding="10,5" Margin="0,0,0,10">
                                <TextBlock Text="Audio Settings" FontWeight="Bold" FontSize="16" 
                                           Foreground="White" VerticalAlignment="Center"/>
                            </Border>
                            
                            <!-- Game Language Setting -->
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Game Language:" VerticalAlignment="Center"
                                           FontWeight="Bold" Margin="0,0,36,0" Foreground="Black"/>
                                <ComboBox Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource MaterialDesignComboBox}"
                                          Foreground="Black"
                                          SelectedIndex="{Binding Language.SelectedLanguageIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Čeština (CZE)" Foreground="Black"/>
                                    <ComboBoxItem Content="Deutsch (DEU)" Foreground="Black"/>
                                    <ComboBoxItem Content="English (INT)" Foreground="Black"/>
                                    <ComboBoxItem Content="Español (ESN)" Foreground="Black"/>
                                    <ComboBoxItem Content="Français (FRA)" Foreground="Black"/>
                                    <ComboBoxItem Content="Italiano (ITA)" Foreground="Black"/>
                                    <ComboBoxItem Content="Magyar (HUN)" Foreground="Black"/>
                                    <ComboBoxItem Content="Polski (POL)" Foreground="Black"/>
                                    <ComboBoxItem Content="Português (POR)" Foreground="Black"/>
                                    <ComboBoxItem Content="Русский (RUS)" Foreground="Black"/>
                                    <ComboBoxItem Content="한국어 (KOR)" Foreground="Black"/>
                                    <ComboBoxItem Content="台灣繁體中文 (CHT)" Foreground="Black"/>
                                    <ComboBoxItem Content="日本語 (JPN)" Foreground="Black"/>
                                    <ComboBoxItem Content="简体中文 (CHS)" Foreground="Black"/>
                                </ComboBox>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Information"
                                        Margin="5,0,0,0"
                                        Command="{Binding Language.ShowGameLanguageInfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>
                            
                            <!-- Audio Backend Setting -->
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Audio Backend:" VerticalAlignment="Center"
                                           FontWeight="Bold" Margin="0,0,43,0" Foreground="Black"/>
                                <ComboBox Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource MaterialDesignComboBox}"
                                          Foreground="Black"
                                          SelectedIndex="{Binding Audio.SelectedAudioBackendIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="OpenAL (default)" Foreground="Black"/>
                                    <ComboBoxItem Content="OpenAL Soft (modern)" Foreground="Black"/>
                                    <ComboBoxItem Content="OpenAL Soft (HRTF)" Foreground="Black"/>
                                </ComboBox>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Information"
                                        Margin="5,0,0,0"
                                        Command="{Binding Audio.ShowAudioBackendInfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid IsHitTestVisible="False" Margin="0,0,15,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5*"/>
                            <RowDefinition Height="90*"/>
                            <RowDefinition Height="5*"/>
                        </Grid.RowDefinitions>
                        <Rectangle Grid.Row="0"
                                   Style="{StaticResource FadeOverlayRectStyle}"
                                   Tag="{Binding ElementName=GameTweaksScrollViewer, Path=(behaviors:SmoothScrollBehavior.ShowTopFade)}">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="White" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Grid.Row="2"
                                   Style="{StaticResource FadeOverlayRectStyle}"
                                   Tag="{Binding ElementName=GameTweaksScrollViewer, Path=(behaviors:SmoothScrollBehavior.ShowBottomFade)}">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="White" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Monitor" Margin="0,0,6,0"/>
                        <TextBlock Text="Graphics Tweaks" FontWeight="Bold"/>
                    </StackPanel>
                </TabItem.Header>
                <Border Background="White" Padding="20">
                    <Grid>
                    <ScrollViewer x:Name="GraphicsTweaksScrollViewer"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  behaviors:SmoothScrollBehavior.SmoothScroll="True"
                                  behaviors:SmoothScrollBehavior.FadeEdges="True"
                                  Focusable="False">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource MaterialDesignScrollViewer}">
                                <Style.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}" />
                                </Style.Resources>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel TextElement.Foreground="Black" Margin="0,0,15,0" 
                                    Focusable="False" KeyboardNavigation.TabNavigation="None">
                            
                            <!-- Video Settings Header -->
                            <Border Background="{DynamicResource PrimaryHueLightBrush}" 
                                    CornerRadius="4" Padding="10,5" Margin="0,0,0,40">
                                <TextBlock Text="Video Settings" FontWeight="Bold" FontSize="16" 
                                           Foreground="White" VerticalAlignment="Center"/>
                            </Border>
                            
                            <Border Margin="0,-10,0,0"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,10,10,8"
                                    Background="#0D000000">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                            <TextBlock Text="Field of Vision (FOV)" FontWeight="Bold" Margin="0,0,0,10"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Width="80"
                                                         Style="{StaticResource MaterialDesignTextBox}"
                                                         Text="{Binding Graphics.NewFovValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <Run Text="Current: "/>
                                                    <Run Text="{Binding Graphics.CurrentFovValue, Mode=OneWay}" FontWeight="SemiBold"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Graphics.HorPlusStatus}"
                                                           Foreground="Gray" FontStyle="Italic"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Top">
                                            <Button Content="Apply"
                                                Command="{Binding Graphics.ApplyFovCommand}"
                                                Padding="20,10"
                                                Height="38"
                                                Style="{StaticResource MaterialDesignRaisedButton}"/>
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                    ToolTip="Information"
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding Graphics.ShowFovInfoCommand}">
                                                <materialDesign:PackIcon Kind="Information" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                        <CheckBox Content="FOV-agnostic sensitivity"
                                                  IsChecked="{Binding Graphics.FovAgnosticSens, Mode=TwoWay}"/>
                                        <CheckBox Content="Compensated near clipping plane"
                                                  IsChecked="{Binding Graphics.CompensatedClip, Mode=TwoWay}"
                                                  Margin="20,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="Note: All following settings below set TdEngine.ini to read-only so Mirror's Edge does not overwrite your changes on launch. As a result, any video settings changed in-game will not be saved."
                                       FontSize="12"
                                       FontStyle="Italic"
                                       Foreground="Gray"
                                       Margin="0,20,0,0"
                                       TextWrapping="Wrap"/>

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Resolution:" VerticalAlignment="Center"
                                           FontWeight="Bold" Margin="0,0,20,0"/>
                                <ComboBox Grid.Column="1" 
                                          VerticalAlignment="Center"
                                          Style="{StaticResource MaterialDesignComboBox}" Margin="0,0,0,0"
                                          ItemsSource="{Binding Graphics.Resolutions}"
                                          DisplayMemberPath="DisplayText"
                                          SelectedItem="{Binding Graphics.SelectedResolution, Mode=TwoWay}"/>
                                <Border Grid.Column="2" Background="{DynamicResource MaterialDesignCardBackground}"
                                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Graphics.HighResFixStatus}" 
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding Graphics.HighResFixStatusForeground}"/>
                                </Border>
                                <Button Grid.Column="3" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Information"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding Graphics.ShowHighResFixInfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>

                            <!-- Render Resolution Slider -->
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Render Resolution:" VerticalAlignment="Center"
                                           FontWeight="Bold" Margin="0,0,20,0"/>
                                <Slider x:Name="RenderResolutionSlider" Grid.Column="1" 
                                        Minimum="25" Maximum="200" 
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"
                                        Value="{Binding Graphics.RenderResolutionPercent, Mode=TwoWay}"/>
                                <TextBlock Grid.Column="2" 
                                           Text="{Binding Graphics.RenderResolutionPercent, StringFormat={}{0:F0}%}" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="45"/>
                                <Button Grid.Column="3" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Information"
                                        Margin="5,0,0,0"
                                        Command="{Binding Graphics.ShowRenderResolutionInfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>

                            <!-- VSync -->
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="VSync:" VerticalAlignment="Center"
                                           FontWeight="Bold" Margin="0,0,20,0"/>
                                <ComboBox Grid.Column="1" 
                                          VerticalAlignment="Center"
                                          Style="{StaticResource MaterialDesignComboBox}"
                                          SelectedIndex="{Binding Graphics.VSync.Index, Mode=TwoWay}"
>
                                    <ComboBoxItem Content="Enabled"/>
                                    <ComboBoxItem Content="Disabled"/>
                                </ComboBox>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Information"
                                        Margin="5,0,0,0"
                                        Command="{Binding Graphics.ShowVSyncInfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>

                            <!-- FPS Limit -->
                            <StackPanel Margin="0,20,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="FPS Limit:" VerticalAlignment="Center"
                                               FontWeight="Bold" Margin="0,0,20,0"/>
                                    <TextBox Grid.Column="1" 
                                             VerticalAlignment="Center"
                                             Style="{StaticResource MaterialDesignTextBox}"
                                             Text="{Binding Graphics.FpsLimitInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="1-2000"/>
                                    <Border Grid.Column="2" Background="{DynamicResource MaterialDesignCardBackground}"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Graphics.FpsLimitStatus}" 
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding Graphics.FpsLimitStatusForeground}"/>
                                    </Border>
                                    <Button Grid.Column="3" Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Information"
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding Graphics.ShowFpsLimitInfoCommand}">
                                        <materialDesign:PackIcon Kind="Information" />
                                    </Button>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="190,0,0,10">
                                    <Button Content="Apply" 
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Command="{Binding Graphics.ApplyFpsLimitCommand}"
                                            Margin="0,0,10,0"/>
                                    <Button Content="Remove Limit" 
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Command="{Binding Graphics.RemoveFpsLimitCommand}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Anti-Aliasing -->
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Anti-Aliasing:" VerticalAlignment="Center"
                                           FontWeight="Bold" Margin="0,0,20,0"/>
                                <ComboBox Grid.Column="1" 
                                          VerticalAlignment="Center"
                                          Style="{StaticResource MaterialDesignComboBox}"
                                          SelectedIndex="{Binding Graphics.AntiAliasingIndex, Mode=TwoWay}"
>
                                    <ComboBoxItem Content="Off"/>
                                    <ComboBoxItem Content="2x"/>
                                    <ComboBoxItem Content="4x"/>
                                    <ComboBoxItem Content="8x"/>
                                    <ComboBoxItem Content="8xQ"/>
                                    <ComboBoxItem Content="16xQ"/>
                                </ComboBox>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Information"
                                        Margin="5,0,0,0"
                                        Command="{Binding Graphics.ShowAntiAliasingInfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>

                            <!-- PhysX -->
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PhysX:" VerticalAlignment="Center"
                                           FontWeight="Bold" Margin="0,0,20,0"/>
                                <ComboBox Grid.Column="1" 
                                          VerticalAlignment="Center"
                                          Style="{StaticResource MaterialDesignComboBox}"
                                          SelectedIndex="{Binding Graphics.PhysX.Index, Mode=TwoWay}"
>
                                    <ComboBoxItem Content="Enabled"/>
                                    <ComboBoxItem Content="Disabled"/>
                                </ComboBox>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Information"
                                        Margin="5,0,0,0"
                                        Command="{Binding Graphics.ShowPhysXInfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>

                            <!-- PhysX FPS -->
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PhysX FPS:" VerticalAlignment="Center"
                                           FontWeight="Bold" Margin="0,0,20,0"/>
                                <TextBox Grid.Column="1" 
                                         VerticalAlignment="Center"
                                         Style="{StaticResource MaterialDesignTextBox}"
                                         Text="{Binding Graphics.PhysXFpsInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="2" Content="Apply"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Margin="10,0,0,0"
                                        Command="{Binding Graphics.ApplyPhysXFpsCommand}"/>
                                <Button Grid.Column="3" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Information"
                                        Margin="5,0,0,0"
                                        Command="{Binding Graphics.ShowPhysXFpsInfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>

                            <Separator Margin="0,20" Style="{StaticResource MaterialDesignDarkSeparator}"/>

                            <!-- Quality Presets Header -->
                            <Border Background="{DynamicResource PrimaryHueLightBrush}" 
                                    CornerRadius="4" Padding="10,5" Margin="0,0,0,5">
                                <TextBlock Text="Quality Presets" FontWeight="Bold" FontSize="16" 
                                           Foreground="White" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Note: Selecting a preset will override any custom individual settings you have applied." 
                                       FontSize="12" FontStyle="Italic" Foreground="Gray" Margin="0,0,0,10"/>

                            <!-- Texture Detail Preset -->
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Texture Detail:" VerticalAlignment="Center"
                                           FontWeight="Bold" Margin="0,0,20,0"/>
                                <ComboBox Grid.Column="1" 
                                          VerticalAlignment="Center"
                                          Style="{StaticResource MaterialDesignComboBox}"
                                          SelectedIndex="{Binding Graphics.TextureDetailIndex, Mode=TwoWay}"
>
                                    <ComboBoxItem Content="Custom" IsEnabled="False" Visibility="{Binding Graphics.IsTextureDetailCustomVisible, Converter={StaticResource BoolToVis}}"/>
                                    <ComboBoxItem Content="Lowest"/>
                                    <ComboBoxItem Content="Low"/>
                                    <ComboBoxItem Content="Medium"/>
                                    <ComboBoxItem Content="High"/>
                                    <ComboBoxItem Content="Highest"/>
                                </ComboBox>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Information"
                                        Margin="5,0,0,0"
                                        Command="{Binding Graphics.ShowTextureDetailInfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>

                            <!-- Graphics Quality Preset -->
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Graphics Quality:" VerticalAlignment="Center"
                                           FontWeight="Bold" Margin="0,0,20,0"/>
                                <ComboBox Grid.Column="1" 
                                          VerticalAlignment="Center"
                                          Style="{StaticResource MaterialDesignComboBox}"
                                          SelectedIndex="{Binding Graphics.GraphicsQualityIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Custom" IsEnabled="False" Visibility="{Binding Graphics.IsGraphicsQualityCustomVisible, Converter={StaticResource BoolToVis}}"/>
                                    <ComboBoxItem Content="Lowest"/>
                                    <ComboBoxItem Content="Low"/>
                                    <ComboBoxItem Content="Medium"/>
                                    <ComboBoxItem Content="High"/>
                                    <ComboBoxItem Content="Highest"/>
                                </ComboBox>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Information"
                                        Margin="5,0,0,0"
                                        Command="{Binding Graphics.ShowGraphicsQualityInfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>

                            <Separator Margin="0,20" Style="{StaticResource MaterialDesignDarkSeparator}"/>

                            <!-- Individual Settings Header -->
                            <Border Background="{DynamicResource PrimaryHueLightBrush}" 
                                    CornerRadius="4" Padding="10,5" Margin="0,0,0,5">
                                <TextBlock Text="Individual Settings" FontWeight="Bold" FontSize="16" 
                                           Foreground="White" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Note: Modifying these settings may cause the in-game video options to display 'Medium' as a fallback label. This does not indicate your settings have been changed to medium quality." 
                                       FontSize="12" FontStyle="Italic" Foreground="Gray" Margin="0,0,0,10" TextWrapping="Wrap"/>

                            <!-- Anisotropic Filtering -->
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Anisotropic Filtering:" VerticalAlignment="Center"
                                           FontWeight="Bold" Margin="0,0,20,0"/>
                                <ComboBox Grid.Column="1" 
                                          VerticalAlignment="Center"
                                          Style="{StaticResource MaterialDesignComboBox}"
                                          SelectedIndex="{Binding Graphics.Anisotropic.Index, Mode=TwoWay}"
>
                                    <ComboBoxItem Content="Off"/>
                                    <ComboBoxItem Content="2x"/>
                                    <ComboBoxItem Content="4x"/>
                                    <ComboBoxItem Content="8x"/>
                                    <ComboBoxItem Content="16x"/>
                                </ComboBox>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Information"
                                        Margin="5,0,0,0"
                                        Command="{Binding Graphics.ShowAnisotropicFilteringInfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>

                            <!-- Static Decals -->
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Static Decals:" VerticalAlignment="Center"
                                           FontWeight="Bold" Margin="0,0,20,0"/>
                                <ComboBox Grid.Column="1" 
                                          VerticalAlignment="Center"
                                          Style="{StaticResource MaterialDesignComboBox}"
                                          SelectedIndex="{Binding Graphics.StaticDecals.Index, Mode=TwoWay}"
>
                                    <ComboBoxItem Content="Enabled"/>
                                    <ComboBoxItem Content="Disabled"/>
                                </ComboBox>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Information"
                                        Margin="5,0,0,0"
                                        Command="{Binding Graphics.ShowStaticDecalsInfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>

                            <!-- Dynamic Decals -->
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Dynamic Decals:" VerticalAlignment="Center"
                                           FontWeight="Bold" Margin="0,0,20,0"/>
                                <ComboBox Grid.Column="1" 
                                          VerticalAlignment="Center"
                                          Style="{StaticResource MaterialDesignComboBox}"
                                          SelectedIndex="{Binding Graphics.DynamicDecals.Index, Mode=TwoWay}"
>
                                    <ComboBoxItem Content="Enabled"/>
                                    <ComboBoxItem Content="Disabled"/>
                                </ComboBox>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Information"
                                        Margin="5,0,0,0"
                                        Command="{Binding Graphics.ShowDynamicDecalsInfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>

                            <!-- Radial Blur -->
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Radial Blur:" VerticalAlignment="Center"
                                           FontWeight="Bold" Margin="0,0,20,0"/>
                                <ComboBox Grid.Column="1" 
                                          VerticalAlignment="Center"
                                          Style="{StaticResource MaterialDesignComboBox}"
                                          SelectedIndex="{Binding Graphics.RadialBlur.Index, Mode=TwoWay}"
>
                                    <ComboBoxItem Content="Enabled"/>
                                    <ComboBoxItem Content="Disabled"/>
                                </ComboBox>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Information"
                                        Margin="5,0,0,0"
                                        Command="{Binding Graphics.ShowRadialBlurInfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>

                            <!-- Streak Effect -->
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Streak Effect:" VerticalAlignment="Center"
                                           FontWeight="Bold" Margin="0,0,20,0"/>
                                <ComboBox Grid.Column="1" 
                                          VerticalAlignment="Center"
                                          Style="{StaticResource MaterialDesignComboBox}"
                                          SelectedIndex="{Binding Graphics.StreakEffectIndex, Mode=TwoWay}"
>
                                    <ComboBoxItem Content="Enabled"/>
                                    <ComboBoxItem Content="Disabled"/>
                                </ComboBox>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Information"
                                        Margin="5,0,0,0"
                                        Command="{Binding Graphics.ShowStreakEffectInfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>

                            <!-- Bloom & DoF -->
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bloom &amp; DoF:" VerticalAlignment="Center"
                                           FontWeight="Bold" Margin="0,0,20,0"/>
                                <ComboBox Grid.Column="1" 
                                          VerticalAlignment="Center"
                                          Style="{StaticResource MaterialDesignComboBox}"
                                          SelectedIndex="{Binding Graphics.BloomDoF.Index, Mode=TwoWay}"
>
                                    <ComboBoxItem Content="Enabled"/>
                                    <ComboBoxItem Content="Disabled"/>
                                </ComboBox>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Information"
                                        Margin="5,0,0,0"
                                        Command="{Binding Graphics.ShowBloomDoFInfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>

                            <!-- Lens Flare -->
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Lens Flare:" VerticalAlignment="Center"
                                           FontWeight="Bold" Margin="0,0,20,0"/>
                                <ComboBox Grid.Column="1" 
                                          VerticalAlignment="Center"
                                          Style="{StaticResource MaterialDesignComboBox}"
                                          SelectedIndex="{Binding Graphics.LensFlare.Index, Mode=TwoWay}"
>
                                    <ComboBoxItem Content="Enabled"/>
                                    <ComboBoxItem Content="Disabled"/>
                                </ComboBox>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Information"
                                        Margin="5,0,0,0"
                                        Command="{Binding Graphics.ShowLensFlareInfoCommand}">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </Grid>

                            <!-- Dynamic Lights -->
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Dynamic Lights:" VerticalAlignment="Center"
                                           FontWeight="Bold" Margin="0,0,20,0"/>
