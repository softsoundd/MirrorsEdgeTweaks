<!--
    SectionExpanderControlTemplate is derived from MaterialDesignExpander
    (MaterialDesignThemes 5.3.2, MaterialDesignTheme.Expander.xaml). Re-diff when upgrading MD.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:controls="clr-namespace:MirrorsEdgeTweaks.Controls">

    <Duration x:Key="SectionExpandDuration">0:0:0.250</Duration>
    <Duration x:Key="SectionCollapseDuration">0:0:0.200</Duration>

    <Thickness x:Key="SectionExpanderBannerPadding">10,5,8,5</Thickness>
    <Thickness x:Key="SectionExpanderBannerBottomMargin">0,0,0,10</Thickness>
    <!-- Video Settings: preserves spacing after banner margin changed from 40 to 10 (FOV box uses Margin="0,-10,0,0"). -->
    <Thickness x:Key="SectionExpanderVideoContentTopMargin">0,30,0,0</Thickness>

    <Style x:Key="SectionExpanderHeaderText" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionExpanderToggleButton" TargetType="{x:Type controls:ExpanderChevronToggle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ExpanderChevronToggle}">
                    <Border Background="Transparent">
                        <materialDesign:PackIcon x:Name="ExpandPath"
                                                 Kind="ChevronDown"
                                                 Height="24"
                                                 Width="24"
                                                 Foreground="{TemplateBinding Foreground}"
                                                 RenderTransformOrigin="0.5,0.5" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionExpanderHorizontalHeaderStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" HorizontalAlignment="Stretch">
                        <Border Background="{DynamicResource PrimaryHueLightBrush}"
                                CornerRadius="4"
                                Padding="{StaticResource SectionExpanderBannerPadding}"
                                Margin="{StaticResource SectionExpanderBannerBottomMargin}"
                                HorizontalAlignment="Stretch">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                                <controls:ExpanderChevronToggle Grid.Column="1"
                                                                  VerticalAlignment="Center"
                                                                  RenderTransformOrigin="0.5,0.5"
                                                                  Foreground="White"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                  Style="{StaticResource SectionExpanderToggleButton}" />
                            </Grid>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SubSectionExpanderHeaderText" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyDark}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SubSectionExpanderHorizontalHeaderStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" HorizontalAlignment="Stretch">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                            <controls:ExpanderChevronToggle Grid.Column="1"
                                                              VerticalAlignment="Center"
                                                              Foreground="{DynamicResource MaterialDesignBodyDark}"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                              Style="{StaticResource SectionExpanderToggleButton}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="SectionExpanderControlTemplate" TargetType="Expander">
        <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ExpansionStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition To="Expanded">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ContentPanel"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1"
                                                 Duration="{StaticResource SectionExpandDuration}" />
                                <DoubleAnimation Storyboard.TargetName="ContentSiteScaleTransform"
                                                 Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                                                 From="0" To="1"
                                                 Duration="{StaticResource SectionExpandDuration}">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </VisualTransition>
                        <VisualTransition To="Collapsed">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ContentPanel"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0"
                                                 Duration="{StaticResource SectionCollapseDuration}" />
                                <DoubleAnimation Storyboard.TargetName="ContentSiteScaleTransform"
                                                 Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                                                 From="1" To="0"
                                                 Duration="{StaticResource SectionCollapseDuration}">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Expanded">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ContentPanel"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="0:0:0" />
                            <DoubleAnimation Storyboard.TargetName="ContentSiteScaleTransform"
                                             Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                                             To="1"
                                             Duration="0:0:0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Collapsed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ContentPanel"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0"
                                             Duration="0:0:0" />
                            <DoubleAnimation Storyboard.TargetName="ContentSiteScaleTransform"
                                             Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                                             To="0"
                                             Duration="0:0:0" />
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <DockPanel Background="{TemplateBinding Background}">
                <ToggleButton x:Name="HeaderSite"
                              DockPanel.Dock="Top"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Focusable="False"
                              IsTabStop="False"
                              BorderThickness="0"
                              Cursor="Hand"
                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              Style="{Binding Path=(controls:SectionExpanderProperties.HorizontalHeaderStyle), RelativeSource={RelativeSource TemplatedParent}}"
                              Background="{TemplateBinding Background}"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                              ContentStringFormat="{TemplateBinding HeaderStringFormat}" />
                <Border x:Name="ContentSite">
                    <Border.LayoutTransform>
                        <ScaleTransform x:Name="ContentSiteScaleTransform" />
                    </Border.LayoutTransform>
                    <Grid x:Name="ContentPanel"
                          Margin="{TemplateBinding Padding}"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                        <ContentPresenter x:Name="PART_Content"
                                          Focusable="False"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                    </Grid>
                </Border>
            </DockPanel>
        </Border>
    </ControlTemplate>

    <Style x:Key="SectionExpander" TargetType="Expander">
        <Setter Property="IsExpanded" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="controls:SectionExpanderProperties.HorizontalHeaderStyle" Value="{StaticResource SectionExpanderHorizontalHeaderStyle}" />
        <Setter Property="Template" Value="{StaticResource SectionExpanderControlTemplate}" />
    </Style>

    <Style x:Key="SubSectionExpander" TargetType="Expander">
        <Setter Property="IsExpanded" Value="False" />
        <Setter Property="Margin" Value="0,25,0,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="controls:SectionExpanderProperties.HorizontalHeaderStyle" Value="{StaticResource SubSectionExpanderHorizontalHeaderStyle}" />
        <Setter Property="Template" Value="{StaticResource SectionExpanderControlTemplate}" />
    </Style>

</ResourceDictionary>
