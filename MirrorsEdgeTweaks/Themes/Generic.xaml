<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:controls="clr-namespace:MirrorsEdgeTweaks.Controls">

    <Style TargetType="{x:Type controls:SettingRow}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{TemplateBinding Label}"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Margin="0,0,20,0" />
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        <Button x:Name="InfoButton"
                                Grid.Column="2"
                                Style="{DynamicResource MaterialDesignIconButton}"
                                Margin="5,0,0,0"
                                Command="{TemplateBinding InfoCommand}"
                                CommandParameter="{TemplateBinding InfoParameter}">
                            <materialDesign:PackIcon Kind="Information" />
                        </Button>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="InfoCommand" Value="{x:Null}">
                            <Setter TargetName="InfoButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
