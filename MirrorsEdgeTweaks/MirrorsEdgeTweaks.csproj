<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>Icon.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<!-- With CET compatibility, the app crashes at startup when hardware-enforced stack protection is on but Windows lacks the required updates. -->
		<CetCompat>false</CetCompat>

		<Version>4.5.0</Version>
		<AssemblyVersion>4.5.0.0</AssemblyVersion>
		<FileVersion>4.5.0.0</FileVersion>
		<InformationalVersion>4.5.0</InformationalVersion>

		<Product>Mirror's Edge Tweaks</Product>
		<AssemblyTitle>Mirror's Edge Tweaks</AssemblyTitle>
		<Description>Modding, settings and fixes for Mirror's Edge</Description>
		<Company>softsoundd</Company>
		<Copyright>Copyright (C) 2025-2026 softsoundd</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<Resource Include="Icon.ico">
		</Resource>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Versions\*.json" />
		<EmbeddedResource Include="StockConfig\**\*.ini" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="MirrorsEdgeTweaks.Tests" />
	</ItemGroup>

	<ItemGroup>
		<!-- Many patches allocate arrays the size of whole game files, and this level makes the GC compact the large object heap rather than grow it. -->
		<RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Eliot.UELib" Version="1.13.7" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
		<PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.161" />
		<PackageReference Include="MaterialDesignThemes" Version="5.4.0" />
	</ItemGroup>

</Project>

